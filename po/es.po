#: prefs.ts:39 prefs.ts:138
msgid "General"
msgstr "General"

#: prefs.ts:44
msgid ""
"When off, Vesper is loaded but does not change the wallpaper automatically."
msgstr ""
"Cuando está desactivado, Vesper está cargado pero no cambia el fondo de "
"pantalla automáticamente."

#: prefs.ts:47 wallpaperManager.ts:169 wallpaperManager.ts:358
msgid "Enable rotation"
msgstr "Activar rotación"

