msgid "Cache"
msgstr "Cache"

#: prefs.ts:101
msgid "Maximum cache size (MB)"
msgstr "Maximale Cache-Größe (MB)"

#: prefs.ts:102
msgid "Older downloads are deleted to stay under this limit."
msgstr "Ältere Downloads werden gelöscht, um unter diesem Limit zu bleiben."

